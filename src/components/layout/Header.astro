---
/**
 * Owns its outer element rather than wrapping in Section: sticky behaviour
 * needs its own positioning and stacking context. Container is used inside.
 *
 * The nav slots are filled by MegaMenu (lg and up) and MobileNav (below lg),
 * both reading src/config/navigation.ts — one tree, two renderings.
 */
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import MegaMenu from './MegaMenu.astro';
import MobileNav from './MobileNav.astro';
import { navigation } from '../../config/navigation';
import { site } from '../../config/site';

export type HeaderSticky = 'static' | 'sticky' | 'shrink' | 'hide-on-scroll';

interface Props {
  sticky?: HeaderSticky;
}

const { sticky = 'sticky' } = Astro.props;

const currentPath = Astro.url.pathname;
const positioned = sticky !== 'static';
---

{
  site.announcement && (
    <p class="bg-accent-600 text-ink-inverse px-4 py-2 text-center text-sm">{site.announcement}</p>
  )
}

<header
  data-sticky={sticky}
  class:list={[
    'group/header bg-surface-base z-50 w-full',
    // The mega panel is absolutely positioned against the header, so the header
    // must be a positioned ancestor even when it isn't sticky.
    positioned ? 'sticky top-0' : 'relative',
  ]}
>
  <div class="border-brand-600 border-b-2">
    <Container
      as="div"
      layout="bar"
      gap="none"
      class="justify-between gap-4 py-3 group-data-[scrolled=true]/header:py-2"
    >
      <a href="/" class="shrink-0">
        <img
          src="/logo.webp"
          alt="Markle Tile & Renovation"
          width="220"
          height="63"
          class="h-14 w-auto max-md:h-12"
        />
      </a>

      <div class="flex min-w-0 flex-1 justify-center">
        <MegaMenu currentPath={currentPath} />
      </div>

      <div class="flex items-center gap-2">
        {
          navigation.cta && (
            <Button
              href={navigation.cta.href}
              size="md"
              class="whitespace-nowrap max-md:hidden"
            >
              {navigation.cta.label}
            </Button>
          )
        }

        <MobileNav currentPath={currentPath} />
      </div>
    </Container>
  </div>
</header>

<style>
  header {
    transition:
      transform 200ms ease,
      padding 150ms ease;
  }

  header[data-hidden='true'] {
    transform: translateY(-100%);
  }

  header[data-scrolled='true'] {
    box-shadow: var(--shadow-sm);
  }

  @media (prefers-reduced-motion: reduce) {
    header {
      transition: none;
    }

    header[data-hidden='true'] {
      transform: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('header[data-sticky]');

  if (header) {
    const mode = header.dataset.sticky;

    if (mode === 'shrink' || mode === 'hide-on-scroll') {
      let lastY = window.scrollY;
      let ticking = false;

      const update = () => {
        const y = window.scrollY;
        header.dataset.scrolled = String(y > 8);

        if (mode === 'hide-on-scroll') {
          // Never retract while the drawer or a mega panel is open.
          const navOpen =
            document.querySelector('#nav-toggle')?.getAttribute('aria-expanded') === 'true' ||
            document.querySelector('.mega-item[data-open="true"]') !== null;
          header.dataset.hidden = String(!navOpen && y > lastY && y > 120);
        }

        lastY = y;
        ticking = false;
      };

      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        },
        { passive: true },
      );

      update();
    }
  }
</script>
