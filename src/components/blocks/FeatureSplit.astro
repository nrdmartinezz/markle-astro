---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import AccentHeading from '../ui/AccentHeading.astro';
import Button from '../ui/Button.astro';
import { Icon } from 'astro-icon/components';
import type { BlockProps, BlockAction } from './types';

type Bullet = string | { text: string; id?: string };

interface Props extends BlockProps {
  id?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  bullets?: Bullet[];
  actions?: BlockAction[];
  /** Image right on desktop by default; small screens always stack image-first. */
  reverse?: boolean;
}

const {
  background = 'base',
  spacing = 'md',
  width = 'page',
  id,
  eyebrow,
  title,
  titleAccent,
  accentBreak,
  body,
  titleLevel = 2,
  image,
  imageAlt = '',
  bullets = [],
  actions = [],
  reverse = false,
} = Astro.props;

const onColor = background === 'accent' || background === 'brand' || background === 'inverse';
const paragraphs = body?.split(/\n\n+/).filter(Boolean) ?? [];
---

<Section id={id} background={background} spacing={spacing}>
  <Container width={width} layout="row" gap="lg">
    <div class:list={['w-full md:w-1/2', reverse ? 'md:order-2' : 'md:order-1']}>
      {
        image ? (
          <Image
            src={image}
            alt={imageAlt}
            widths={[480, 768, 1024]}
            sizes="(max-width: 768px) 100vw, 50vw"
            loading="lazy"
            class="w-full rounded-lg object-cover"
          />
        ) : (
          <div class="bg-surface-muted aspect-4/3 w-full rounded-lg" aria-hidden="true" />
        )
      }
    </div>

    <div
      class:list={[
        'flex flex-col items-start gap-5 md:w-1/2',
        reverse ? 'md:order-1' : 'md:order-2',
      ]}
    >
      {
        eyebrow && (
          <p
            class:list={[
              'text-sm font-semibold tracking-wide uppercase',
              onColor ? 'opacity-80' : 'text-accent-600',
            ]}
          >
            {eyebrow}
          </p>
        )
      }
      {
        title && (
          <AccentHeading
            level={titleLevel}
            title={title}
            titleAccent={onColor ? undefined : titleAccent}
            accentBreak={accentBreak}
            class={onColor ? 'text-inherit' : undefined}
          />
        )
      }
      {
        paragraphs.map((paragraph) => (
          <p class:list={['max-w-reading', onColor ? 'opacity-90' : 'text-ink-muted']}>
            {paragraph}
          </p>
        ))
      }

      {
        bullets.length > 0 && (
          <ul class="flex flex-col gap-2">
            {bullets.map((bullet) => {
              const text = typeof bullet === 'string' ? bullet : bullet.text;
              const bulletId = typeof bullet === 'string' ? undefined : bullet.id;
              return (
                <li id={bulletId} class="flex items-start gap-3">
                  <Icon
                    name="lucide:check"
                    class:list={['mt-1 size-5 shrink-0', onColor ? 'opacity-80' : 'text-brand-600']}
                    aria-hidden="true"
                  />
                  <span>{text}</span>
                </li>
              );
            })}
          </ul>
        )
      }

      {
        actions.length > 0 && (
          <div class="flex flex-wrap gap-3">
            {actions.map((action) => (
              <Button href={action.href} variant={action.variant ?? 'primary'}>
                {action.label}
              </Button>
            ))}
          </div>
        )
      }
    </div>
  </Container>
</Section>
