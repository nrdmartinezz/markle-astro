---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import BlockHeader from './BlockHeader.astro';
import type { BlockProps } from './types';

export interface Stat {
  value: string;
  label: string;
  /** Short line under the figure. */
  detail?: string;
}

interface Props extends BlockProps {
  items: Stat[];
  /** Caption sits above the figure, matching stat bands that label first. */
  labelFirst?: boolean;
}

const {
  background = 'base',
  spacing = 'md',
  align = 'start',
  width = 'page',
  eyebrow,
  title,
  titleAccent,
  accentBreak,
  body,
  titleLevel = 2,
  items,
  labelFirst = false,
} = Astro.props;

const columnClass = items.length === 4 ? 'sm:grid-cols-2 lg:grid-cols-4' : 'sm:grid-cols-3';
---

<Section background={background} spacing={spacing}>
  <Container width={width} align={align} gap="lg">
    <BlockHeader
      eyebrow={eyebrow}
      title={title}
      titleAccent={titleAccent}
      accentBreak={accentBreak}
      body={body}
      level={titleLevel}
      centered={align === 'center'}
    />

    <dl class:list={['grid w-full gap-8', columnClass]}>
      {
        items.map((stat) => (
          <div class="flex flex-col gap-1">
            {/* Value reads first visually; DOM order keeps dt before dd. */}
            <dt class:list={['text-ink-muted', !labelFirst && 'order-2']}>{stat.label}</dt>
            <dd
              class:list={[
                'text-ink-brand text-4xl font-semibold tracking-tight',
                !labelFirst && 'order-1',
              ]}
            >
              {stat.value}
            </dd>
            {stat.detail && <p class="text-ink-muted order-3 text-sm">{stat.detail}</p>}
          </div>
        ))
      }
    </dl>
  </Container>
</Section>
