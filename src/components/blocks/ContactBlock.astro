---
/**
 * Contact form block — posts to /api/submit.php via SiteFormHandler.
 */
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Field from '../ui/Field.astro';
import FormMessage from '../ui/FormMessage.astro';
import Button from '../ui/Button.astro';
import BlockHeader from './BlockHeader.astro';
import { Icon } from 'astro-icon/components';
import { site, formattedAddress } from '../../config/site';
import type { BlockProps } from './types';

interface Props extends BlockProps {
  services?: string[];
  hearAbout?: string[];
  showDetails?: boolean;
}

const {
  background = 'base',
  spacing = 'md',
  width = 'page',
  eyebrow,
  title = 'Get in touch',
  titleAccent,
  accentBreak,
  body,
  titleLevel = 2,
  services = [],
  hearAbout = [],
  showDetails = true,
} = Astro.props;

const action = site.formEndpoint || '';
const thankYou = new URL('/thank-you/', site.url).href;
---

<Section background={background} spacing={spacing}>
  <Container width={width} layout="row" gap="lg" class="md:items-start">
    <div class="flex flex-col gap-6 md:w-3/5">
      <BlockHeader
        eyebrow={eyebrow}
        title={title}
        titleAccent={titleAccent}
        accentBreak={accentBreak}
        body={body}
        level={titleLevel}
      />

      {
        !action && (
          <p class="rounded-md border border-amber-300 bg-amber-50 p-3 text-sm text-amber-900">
            No <code>formEndpoint</code> in <code>src/config/site.ts</code> — this form will not
            submit until one is set.
          </p>
        )
      }

      <form
        id="contact-form"
        action={action}
        method="POST"
        novalidate
        class="flex w-full flex-col gap-4"
        data-site-form
        data-thank-you={thankYou}
        data-track-source="contact-form"
      >
        {action && <input type="hidden" name="form_type" value="contact" />}

        {/* Honeypot: bots fill it, humans never see it. */}
        <div class="absolute left-[-9999px]" aria-hidden="true">
          <label for="_gotcha">Leave this field empty</label>
          <input type="text" id="_gotcha" name="_gotcha" tabindex="-1" autocomplete="off" />
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <Field name="name" label="Name" autocomplete="name" required />
          <Field name="email" label="Email" type="email" autocomplete="email" required />
          <Field name="phone" label="Phone" type="tel" autocomplete="tel" />
          {
            services.length > 0 && (
              <Field
                name="service"
                label="Service you're interested in"
                type="select"
                required
                options={[
                  { label: 'Select a service', value: '' },
                  ...services.map((service) => ({ label: service, value: service })),
                ]}
              />
            )
          }
        </div>

        {
          hearAbout.length > 0 && (
            <Field
              name="hear_about_us"
              label="How did you hear about us?"
              type="select"
              required
              options={[
                { label: 'Select an option', value: '' },
                ...hearAbout.map((source) => ({ label: source, value: source })),
              ]}
            />
          )
        }

        <Field name="message" label="Message" type="textarea" required />

        <FormMessage />

        <Button type="submit" size="lg" class="self-start">Send message</Button>
      </form>
    </div>

    {
      showDetails && (
        <aside class="bg-surface-muted flex w-full flex-col gap-4 rounded-lg p-6 md:w-2/5">
          <h3 class="font-semibold">Prefer to talk?</h3>

          <a
            href={`tel:${site.business.phoneHref}`}
            data-source="contact-block"
            class="text-ink-base inline-flex min-h-11 items-center gap-2 no-underline"
          >
            <Icon name="lucide:phone" class="text-brand-600 size-5" aria-hidden="true" />
            {site.business.phone}
          </a>

          {site.business.email && (
            <a
              href={`mailto:${site.business.email}`}
              class="text-ink-base inline-flex min-h-11 items-center gap-2 break-all no-underline"
            >
              <Icon name="lucide:mail" class="text-brand-600 size-5" aria-hidden="true" />
              {site.business.email}
            </a>
          )}

          <p class="flex items-start gap-2">
            <Icon
              name="lucide:map-pin"
              class="text-brand-600 mt-1 size-5 shrink-0"
              aria-hidden="true"
            />
            <span>{formattedAddress}</span>
          </p>

          <dl class="text-ink-muted flex flex-col gap-1 text-sm">
            <dt class="font-medium">Hours</dt>
            <dd>{site.business.hoursLabel ?? site.business.hours.join(', ')}</dd>
          </dl>
        </aside>
      )
    }
  </Container>
</Section>

<script>
  import { bindOutboundConversions } from '../../lib/track';

  bindOutboundConversions();
</script>
