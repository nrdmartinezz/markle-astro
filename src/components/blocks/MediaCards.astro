---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import BlockHeader from './BlockHeader.astro';
import type { BlockProps } from './types';

export type CardTone = 'copper' | 'blue' | 'sage';

export interface MediaCard {
  eyebrow?: string;
  title: string;
  body?: string;
  href?: string;
  linkLabel?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /** astro-icon name. Used by solid cards. */
  icon?: string;
  tone?: CardTone;
}

interface Props extends BlockProps {
  items: MediaCard[];
  columns?: 2 | 3;
  /** Photo with a sage caption, or a solid colored icon card. */
  variant?: 'photo' | 'solid';
  /** Wide image between the heading and the cards. */
  featureImage?: ImageMetadata;
  featureImageAlt?: string;
}

const {
  background = 'base',
  spacing = 'md',
  align = 'start',
  width = 'page',
  eyebrow,
  title,
  titleAccent,
  accentBreak,
  body,
  titleLevel = 2,
  items,
  columns = 3,
  variant = 'photo',
  featureImage,
  featureImageAlt = '',
} = Astro.props;

const tones: Record<CardTone, string> = {
  copper: 'bg-brand-600',
  blue: 'bg-info-500',
  sage: 'bg-accent-600',
};

const gridClass =
  columns === 2
    ? 'grid-cols-2 max-md:grid-cols-1'
    : 'grid-cols-3 max-lg:grid-cols-2 max-md:grid-cols-1';
---

<Section background={background} spacing={spacing}>
  <Container width={width} align={align} gap="lg">
    <BlockHeader
      eyebrow={eyebrow}
      title={title}
      titleAccent={titleAccent}
      accentBreak={accentBreak}
      body={body}
      level={titleLevel}
      centered={align === 'center'}
    />

    {
      featureImage && (
        <Image
          src={featureImage}
          alt={featureImageAlt}
          widths={[768, 1200, 1600]}
          sizes="100vw"
          class="w-full rounded-xl object-cover"
        />
      )
    }

    <ul class:list={['grid w-full gap-6', gridClass]}>
      {
        items.map((item) => (
          <li>
            {variant === 'photo' ? (
              <article class="flex h-full flex-col overflow-hidden rounded-xl">
                {item.image && (
                  <Image
                    src={item.image}
                    alt={item.imageAlt ?? ''}
                    widths={[480, 768]}
                    sizes="(max-width: 768px) 100vw, 50vw"
                    class="aspect-4/3 w-full object-cover"
                  />
                )}
                <div
                  data-bg="accent"
                  class="bg-accent-600 flex flex-1 flex-col gap-2 p-6 text-white"
                >
                  {item.eyebrow && <p class="text-sm">{item.eyebrow}</p>}
                  <h3 class="text-2xl font-semibold text-inherit">{item.title}</h3>
                  {item.body && <p class="text-white/90">{item.body}</p>}
                  {item.href && (
                    <a
                      href={item.href}
                      class="mt-auto inline-flex min-h-11 items-center gap-1 pt-2 font-medium text-white no-underline"
                    >
                      {item.linkLabel ?? 'Learn More'}
                      <Icon name="lucide:chevron-right" class="size-4" aria-hidden="true" />
                    </a>
                  )}
                </div>
              </article>
            ) : (
              <article
                class:list={[
                  'flex h-full flex-col gap-4 rounded-2xl p-6 text-white',
                  tones[item.tone ?? 'copper'],
                ]}
              >
                {item.icon && (
                  <span class="inline-flex size-12 items-center justify-center rounded-lg bg-white/20">
                    <Icon name={item.icon} class="size-6" aria-hidden="true" />
                  </span>
                )}
                <h3 class="text-2xl font-semibold text-inherit">{item.title}</h3>
                {item.body && <p class="text-white/90">{item.body}</p>}
                {item.href && (
                  <a
                    href={item.href}
                    class="mt-auto inline-flex min-h-11 items-center gap-1 pt-2 font-medium text-white no-underline"
                  >
                    {item.linkLabel ?? 'Learn More'}
                    <Icon name="lucide:chevron-right" class="size-4" aria-hidden="true" />
                  </a>
                )}
              </article>
            )}
          </li>
        ))
      }
    </ul>
  </Container>
</Section>
