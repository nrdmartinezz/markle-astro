---
import BaseLayout from '../layouts/BaseLayout.astro';
import OverlayHero from '../components/blocks/OverlayHero.astro';
import MediaCards from '../components/blocks/MediaCards.astro';
import FeatureSplit from '../components/blocks/FeatureSplit.astro';
import Stats from '../components/blocks/Stats.astro';
import CTABanner from '../components/blocks/CTABanner.astro';
import { site } from '../config/site';
import heroHome from '../assets/markle/hero-home.webp';
import tileWorker from '../assets/markle/hero-page.webp';
import kitchenUnderway from '../assets/markle/tile-work.webp';
import blueTile from '../assets/markle/kitchen-home.webp';
import ctaPhoto from '../assets/markle/cta-project.webp';
import aerial from '../assets/markle/service-area.webp';

const phone = {
  label: `Call Us: ${site.business.phone}`,
  href: `tel:${site.business.phoneHref}`,
  variant: 'outline-inverse' as const,
};
---

<BaseLayout
  title="Markle Tile – General Contractor near Fort Myers, FL"
  titleExact
  description={site.description}
>
  <OverlayHero
    image={heroHome}
    imageAlt="Stacked marble and stone tile slabs"
    title="Tile and renovation done right"
    body="We build spaces that last. From precise tile work to complete home transformations, Markle Tile handles every detail with the care it deserves."
    actions={[
      { label: 'Get Started', href: '/contact-us/' },
      { label: 'View Services', href: '/our-services/', variant: 'outline-inverse' },
    ]}
  />

  <MediaCards
    align="center"
    columns={2}
    eyebrow="What we do"
    title="Craftsmanship in Every Project"
    titleAccent="Every Project"
    body="We build spaces that last. From precise tile work to complete home transformations, Markle Tile handles every detail with the care it deserves."
    items={[
      {
        eyebrow: 'Tile',
        title: 'Tile installation',
        body: 'From elegant bathroom floors to stunning kitchen backsplashes, we provide expert tile installation that combines precision craftsmanship with durable, long-lasting results.',
        href: '/our-services/',
        image: tileWorker,
        imageAlt: 'Installer setting floor tile with a trowel in Fort Myers',
      },
      {
        eyebrow: 'Exteriors',
        title: 'Windows, doors, and trim',
        body: "Our window and door trim services give your home a polished, finished look — whether you're updating outdated molding or adding trim for the first time.",
        href: '/our-services/',
        image: kitchenUnderway,
        imageAlt: 'Kitchen remodel in progress with new cabinets and windows',
      },
    ]}
  />

  <FeatureSplit
    eyebrow="Remodeling"
    title="Kitchen and bathroom transformations"
    titleAccent="transformations"
    image={blueTile}
    imageAlt="Glazed blue tile installed in a running bond pattern"
    body="With years of experience in kitchen and bathroom renovations, we bring craftsmanship and attention to detail to every project, whether it's a simple refresh or a complete gut renovation. We work closely with homeowners to design spaces that are both beautiful and functional, built to last."
    actions={[{ label: 'Learn More About Remodels', href: '/our-services/' }]}
  />

  <Stats
    background="muted"
    align="center"
    labelFirst
    title="Built on Quality, Measured in Results"
    titleAccent="Measured in Results"
    body="Markle Tile has completed hundreds of residential and commercial projects across Fort Myers. We measure success by the lasting satisfaction of our clients and the durability of every installation."
    items={[
      { value: '15+', label: 'Year in business', detail: 'Serving Fort Myers with dedication' },
      { value: '500+', label: 'Projects completed', detail: 'From kitchens to commercial spaces' },
      { value: '300+', label: 'Clients served', detail: 'Residential and commercial alike' },
    ]}
  />

  <CTABanner
    background="accent"
    width="page"
    title="Ready to start your project"
    body="Get a quote or schedule a consultation with our team. We'll discuss your vision and deliver honest guidance."
    actions={[{ label: 'Request Quote', href: '/contact-us/' }, phone]}
    image={ctaPhoto}
    imageAlt="Finished tile and renovation project by Markle Tile"
  />

  <MediaCards
    align="center"
    columns={3}
    eyebrow="Servicing Fort Myers, FL, and surrounding areas"
    title="Where We Work"
    body="We build spaces that last. From precise tile work to complete home transformations, Markle Tile handles every detail with the care it deserves."
    featureImage={aerial}
    featureImageAlt="Aerial view of Fort Myers, Florida"
    items={[
      {
        eyebrow: 'Fort Myers',
        title: 'Main office',
        body: '11000 Metro Parkway, Unit 24, Fort Myers',
        href: site.mapsUrl,
        linkLabel: 'Get directions',
      },
      {
        eyebrow: 'Service Radius',
        title: 'Southwest Florida',
        body: 'We serve Fort Myers, Cape Coral, and surrounding areas',
      },
      {
        eyebrow: 'Available',
        title: 'Monday through Friday',
        body: '9am to 5pm local time',
        href: phone.href,
        linkLabel: 'Call now',
      },
    ]}
  />

  <CTABanner
    background="accent"
    title="Ready To Start Your Next Project?"
    body="Get a free quote or schedule a consultation with our team. We'll discuss your vision and deliver honest, expert guidance — no pressure, no obligation."
    actions={[{ label: 'Request a Quote', href: '/contact-us/' }, phone]}
  />
</BaseLayout>
