---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import { navigation } from '../../config/navigation';
import { site, formattedAddress } from '../../config/site';
import { Icon } from 'astro-icon/components';

const socialIcons: Record<string, string> = {
  facebook: 'lucide:facebook',
  instagram: 'lucide:instagram',
  linkedin: 'lucide:linkedin',
  x: 'lucide:twitter',
  youtube: 'lucide:youtube',
  tiktok: 'lucide:music',
};

const socials = Object.entries(site.social).filter(([, href]) => Boolean(href)) as [
  string,
  string,
][];
const year = new Date().getFullYear();
const hours = site.business.hoursLabel ?? site.business.hours.join(', ');
---

<Section as="footer" background="base" spacing="md" class="border-line-base border-t">
  <Container gap="lg">
    <div class="grid w-full gap-10 md:grid-cols-3">
      <div class="flex flex-col gap-4">
        <a href="/">
          <img
            src="/logo.webp"
            alt="Markle Tile & Renovation"
            width="220"
            height="63"
            class="h-14 w-auto max-md:h-12"
          />
        </a>
        {
          site.mapsUrl && (
            <a
              href={site.mapsUrl}
              class="text-ink-base hover:text-ink-brand font-medium no-underline"
            >
              General Contractor near Fort Myers, FL
            </a>
          )
        }
      </div>

      {
        navigation.footer.map((group) => (
          <nav aria-label={group.heading} class="flex flex-col gap-3">
            <h2 class="text-ink-heading text-lg font-semibold">{group.heading}</h2>
            <ul class="flex flex-col gap-1">
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-ink-muted hover:text-ink-brand inline-flex min-h-11 items-center no-underline"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div class="flex flex-col gap-3">
        <h2 class="text-ink-heading text-lg font-semibold">Contact Us</h2>
        <ul class="text-ink-muted flex flex-col gap-1">
          <li>
            <a
              href={site.mapsUrl ??
                `https://maps.google.com/?q=${encodeURIComponent(formattedAddress)}`}
              class="hover:text-ink-brand inline-flex min-h-11 items-start gap-2 no-underline"
            >
              <Icon
                name="lucide:map-pin"
                class="text-brand-600 mt-1 size-4 shrink-0"
                aria-hidden="true"
              />
              <span>{formattedAddress}</span>
            </a>
          </li>
          <li>
            <a
              href={`tel:${site.business.phoneHref}`}
              class="hover:text-ink-brand inline-flex min-h-11 items-center gap-2 no-underline"
            >
              <Icon name="lucide:phone" class="text-brand-600 size-4" aria-hidden="true" />
              {site.business.phone}
            </a>
          </li>
          {
            site.business.email && (
              <li>
                <a
                  href={`mailto:${site.business.email}`}
                  class="hover:text-ink-brand inline-flex min-h-11 items-center gap-2 no-underline"
                >
                  <Icon name="lucide:mail" class="text-brand-600 size-4" aria-hidden="true" />
                  {site.business.email}
                </a>
              </li>
            )
          }
          <li class="inline-flex min-h-11 items-center gap-2">
            <Icon name="lucide:clock" class="text-brand-600 size-4" aria-hidden="true" />
            {hours}
          </li>
        </ul>
      </div>
    </div>

    {
      socials.length > 0 && (
        <ul class="flex gap-2">
          {socials.map(([platform, href]) => (
            <li>
              <a
                href={href}
                rel="noopener noreferrer"
                target="_blank"
                class="hover:text-ink-brand text-ink-muted inline-flex size-11 items-center justify-center rounded-md no-underline"
              >
                <span class="sr-only">{platform}</span>
                <Icon
                  name={socialIcons[platform] ?? 'lucide:link'}
                  class="size-5"
                  aria-hidden="true"
                />
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <div
      class="border-line-base text-ink-muted flex w-full flex-col gap-3 border-t pt-6 text-sm md:flex-row md:items-center md:justify-between"
    >
      <p>&copy; {year} {site.legalName ?? site.name}. All rights reserved.</p>
      {
        site.credit ? (
          <a
            href={site.credit.href}
            class="hover:text-ink-brand no-underline"
            rel="noopener noreferrer"
          >
            {site.credit.label}
          </a>
        ) : (
          <ul class="flex flex-wrap gap-4">
            {navigation.legal.map((link) => (
              <li>
                <a href={link.href} class="hover:text-ink-brand no-underline">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </Container>
</Section>
